# Signing key is requirements/RPM-GPG-KEY-centosofficial
# (CentOS Official fingerprint 99DB70FAE1D7CE227FB6488205B555B38483C65D).
# Image/CI imports that file; the URL below is for lockfile generation.
# includepkgs=snappy so this repo cannot pull the rest of Stream BaseOS.
[centos-stream-9-baseos]
name = CentOS Stream 9 - BaseOS - $basearch
baseurl = https://mirror.stream.centos.org/9-stream/BaseOS/$basearch/os/
enabled = 1
gpgcheck = 1
gpgkey = https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official-SHA256
includepkgs = snappy

[centos-stream-9-baseos-source]
name = CentOS Stream 9 - BaseOS - Source
baseurl = https://mirror.stream.centos.org/9-stream/BaseOS/source/tree/
enabled = 1
gpgcheck = 1
gpgkey = https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official-SHA256
includepkgs = snappy
